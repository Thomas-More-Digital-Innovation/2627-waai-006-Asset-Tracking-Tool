BACKEND_PORT=8000
FRONTEND_PORT=5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=asset_tracking
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

JWT_SECRET=change-me
COOKIE_SECURE=false

# Method of authentication, either "email" or "sso"
AUTH_METHOD=email

# The admin account that is created on start.
# With "email" both are required, with "sso" the email is optional and the password is not used:
# that Microsoft account becomes admin, every other account of the tenant starts as a normal user.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Azure AD Configuration only fill in if we are using SSO
AZURE_TENANT_ID=x
AZURE_CLIENT_ID=x
AZURE_CLIENT_SECRET=x

# Address of the frontend, defaults to http://localhost:FRONTEND_PORT.
# Register APP_URL/api/auth/sso/callback as Web redirect URI in the Azure app registration.
APP_URL=http://localhost:5173