BACKEND_PORT=8000
FRONTEND_PORT=5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=asset_tracking
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

JWT_SECRET=change-me
COOKIE_SECURE=false

# Method of authentication, either "email" or "sso"
AUTH_METHOD=email

# The admin account that is created on start.
# With "email" both are required, with "sso" the email is optional and the password is not used:
# that Microsoft account becomes admin, every other account of the tenant starts as a normal user.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Azure AD Configuration, fill in when using SSO or MAIL_SENDER
AZURE_TENANT_ID=x
AZURE_CLIENT_ID=x
AZURE_CLIENT_SECRET=x

# Mailbox in the tenant that sends the reminders for items not given back, leave empty to send no mails.
# Needs the app registration permission: Mail.Send
MAIL_SENDER=
# How many hours after the end of a reservation the reminder is sent, when the items are not back yet
REMINDER_AFTER_HOURS=4

# Must match a Web redirect URI of the Azure app registration exactly
AZURE_REDIRECT_URI=http://localhost:5173/api/auth/sso/callback

# Address of the frontend, defaults to http://localhost:FRONTEND_PORT.
APP_URL=http://localhost:5173