{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start dev",
      "dependsOn": ["Backend: dev", "Frontend: dev"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Backend: dev",
      "type": "shell",
      "command": ".venv/bin/uvicorn app.main:app --reload --port 8000 --env-file ../.env",
      "windows": {
        "command": ".venv\\Scripts\\uvicorn app.main:app --reload --port 8000 --env-file ..\\.env"
      },
      "options": { "cwd": "${workspaceFolder}/code/backend" },
      "isBackground": true,
      "presentation": { "group": "dev" },
      "dependsOn": ["Database: start"],
      "problemMatcher": []
    },
    {
      "label": "Frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/code/frontend" },
      "isBackground": true,
      "presentation": { "group": "dev" },
      "problemMatcher": []
    },
    {
      "label": "Database: start",
      "type": "shell",
      "command": "docker compose up -d --wait db",
      "options": { "cwd": "${workspaceFolder}/code" },
      "presentation": { "group": "dev" },
      "problemMatcher": []
    },
    {
      "label": "Setup",
      "dependsOn": ["Backend: install", "Frontend: install"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Backend: install",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
      "windows": {
        "command": "python -m venv .venv; .venv\\Scripts\\pip install -r requirements.txt"
      },
      "options": { "cwd": "${workspaceFolder}/code/backend" },
      "presentation": { "group": "setup" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/code/frontend" },
      "presentation": { "group": "setup" },
      "problemMatcher": []
    }
  ]
}
